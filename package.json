{
  "name": "innox-v2",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run posts:gen && next dev --turbopack",
    "build": "bun run posts:gen && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .next .open-next",
    "posts:gen": "tsx ./src/lib/posts-generator.ts",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "cf:build": "bun run clean && bun run posts:gen && opennextjs-cloudflare build",
    "cf:deploy": "bun run cf:build && opennextjs-cloudflare deploy",
    "cf:preview": "bun run cf:build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.0.16",
    "@next/third-parties": "15.3.2",
    "@opennextjs/cloudflare": "1.14.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.511.0",
    "motion": "^12.17.3",
    "next": "15.5.9",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sharp": "^0.34.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.4",
    "typescript": "^5",
    "wrangler": "^4.25.0"
  }
}
